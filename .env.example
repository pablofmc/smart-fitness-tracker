# Copy to .env.local and fill in. In production these go in Vercel → Settings → Environment Variables.
# Local values come from: pnpm exec supabase status

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). Server only: it bypasses RLS.
SUPABASE_SECRET_KEY=
# Shared with the Supabase cron job; the same value goes in Vault as sync_secret. Locally: local-dev-sync-secret
SYNC_SECRET=
